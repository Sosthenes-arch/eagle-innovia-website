---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/lib/url';

const links = [
  { label: 'Home', href: '/' },
  { label: 'Technology — Light Cloud', href: '/technology' },
  { label: 'Healthcare — Ozzie Health Consult', href: '/healthcare' },
  { label: 'Academy', href: '/academy' },
  { label: 'About us', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<BaseLayout title="Page not found | Eagle Innovia Ltd" description="Sorry, we could not find that page." noindex>
  <section class="on-dark hero-dark text-white">
    <div class="container-site py-20 text-center sm:py-28">
      <p class="font-decorative text-6xl font-bold text-lime sm:text-8xl">404</p>
      <h1 class="mt-4 text-3xl text-white sm:text-4xl">We could not find that page</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white/85">
        The page may have moved, or the link may be wrong. Try one of these instead.
      </p>
      <ul class="mx-auto mt-10 grid max-w-2xl gap-3 sm:grid-cols-2">
        {
          links.map((l) => (
            <li>
              <a href={url(l.href)} class="btn-outline-light w-full">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
