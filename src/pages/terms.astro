---
// DRAFT — FOR LEGAL REVIEW. These website terms are a starting draft and must be reviewed by a
// qualified lawyer before relying on them.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ObfuscatedEmail from '@/components/ObfuscatedEmail.astro';
import { site } from '@/config/site';
import { url } from '@/lib/url';
const updated = '9 November 2026';
---

<BaseLayout
  title="Terms of Use | Eagle Innovia Ltd"
  description="The terms that apply when you use the Eagle Innovia Ltd website."
  breadcrumbs={[{ name: 'Terms', path: '/terms' }]}
>
  <section class="section">
    <article class="container-site prose-site max-w-3xl">
      <h1 class="mb-2 text-3xl sm:text-4xl">Terms of use</h1>
      <p class="text-ink-muted">Last updated: {updated}</p>

      <h2>About these terms</h2>
      <p>
        This website is run by {site.name}, a company registered in Nigeria and based in {site.location.display}.
        By using this website you agree to these terms. If you do not agree, please do not use the site.
      </p>

      <h2>Information on this website</h2>
      <p>
        We work to keep the content accurate and up to date, but it is general information only. It is not
        professional, medical or legal advice. Health education content does not replace advice from your own
        doctor or healthcare provider.
      </p>

      <h2>Services and products</h2>
      <p>
        Any services we provide are covered by a separate written agreement or proposal. Digital and physical
        products bought through third-party stores such as Selar or Amazon are also covered by those stores' terms.
      </p>

      <h2>Free courses</h2>
      <p>
        Our free courses are provided as they are. You are responsible for any costs in your own cloud accounts
        while following the labs.
      </p>

      <h2>Intellectual property</h2>
      <p>
        The content, logos and design of this website belong to {site.name} unless stated otherwise. You may share
        links to our pages, but you may not copy our content for commercial use without permission.
      </p>

      <h2>Links to other websites</h2>
      <p>We link to other websites, such as YouTube, GitHub and Calendly. We are not responsible for their content.</p>

      <h2>Liability</h2>
      <p>
        As far as the law allows, we are not liable for any loss caused by using this website. Nothing in these
        terms limits liability that cannot be limited by law.
      </p>

      <h2>Privacy</h2>
      <p>Read our <a href={url('/privacy')}>privacy notice</a> to see how we handle personal data.</p>

      <h2>Governing law</h2>
      <p>These terms are governed by the laws of the Federal Republic of Nigeria.</p>

      <h2>Contact</h2>
      <p>Questions about these terms? Email <ObfuscatedEmail {...site.emails.info} />.</p>
    </article>
  </section>
</BaseLayout>
