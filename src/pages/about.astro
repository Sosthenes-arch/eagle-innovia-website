---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import DivisionCard from '@/components/DivisionCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CertStrip from '@/components/CertStrip.astro';
import CTABand from '@/components/CTABand.astro';
import Icon from '@/components/Icon.astro';
import { site, isSet } from '@/config/site';
import { divisions } from '@/lib/nav';
import { localBusinessSchema } from '@/lib/schema';

const values = [
  { icon: 'lightbulb', title: 'Innovation', text: 'We look for better, simpler ways to solve real problems.' },
  { icon: 'scale', title: 'Integrity', text: 'We are honest about what we can do, what it costs and how long it takes.' },
  { icon: 'award', title: 'Excellence', text: 'We do careful work and check it before we hand it over.' },
  {
    icon: 'microscope',
    title: 'Evidence & Responsibility',
    text: 'We base decisions on evidence and take responsibility for the results, especially in healthcare.',
  },
  { icon: 'users', title: 'Customer Centricity', text: 'We start with what our clients need, not with what we want to sell.' },
  { icon: 'graduation', title: 'Learning', text: 'We keep learning and share what we know through our Academy.' },
  { icon: 'target', title: 'Impact', text: 'We measure success by the difference our work makes for people.' },
];
---

<BaseLayout
  title="About Eagle Innovia Ltd | Health, Technology, Education"
  description="Eagle Innovia Ltd is a registered company focused on health, technology, education and innovation for clients worldwide."
  breadcrumbs={[{ name: 'About', path: '/about' }]}
  schema={[localBusinessSchema()]}
>
  <Hero
    eyebrow="About us"
    title="One company, serving clients worldwide"
    lead="Eagle Innovia Ltd brings technology, healthcare and education together. We serve clients in the UK, USA, Canada, Switzerland, the EU and Nigeria."
  />

  <section class="section" aria-labelledby="story-heading">
    <div class="container-site grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Our story</p>
        <h2 id="story-heading" class="text-2xl sm:text-3xl">Health, technology, education and innovation</h2>
        <div class="prose-site mt-5 text-ink-muted">
          <p>
            Eagle Innovia brings together two areas of expertise, technology and healthcare, under one
            company. Our teams build and run cloud systems, support healthcare providers remotely and train
            people for remote careers.
          </p>
          <p>
            Each division has its own focus, but they share people, standards and values. Our cloud engineers
            support our healthcare clients' systems, and both teams teach through the Academy.
          </p>
        </div>
      </div>
      <div class="card p-8">
        <p class="eyebrow">Our mission</p>
        <p class="font-heading text-2xl leading-snug font-semibold">
          To deliver practical cloud, healthcare and education solutions that clients trust,
          wherever they are.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            site.focus.map((f) => (
              <li class="rounded-full bg-lime-light px-3 py-1 text-sm font-bold text-midnight">{f}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-off-white" aria-labelledby="values-heading">
    <div class="container-site">
      <SectionHeading id="values-heading" eyebrow="Our values" title="Seven values that guide our work" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => <ServiceCard {...v} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="divisions-heading">
    <div class="container-site">
      <SectionHeading id="divisions-heading" eyebrow="Our divisions" title="How we are organised" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {divisions.map((d) => <DivisionCard {...d} />)}
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="card flex gap-4 p-6">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[12px] bg-teal-light text-teal">
            <Icon name="shop" />
          </span>
          <div>
            <h3 class="text-lg">Digital Products</h3>
            <p class="mt-1 text-ink-muted">
              Ebooks, templates, courses and workbooks sold on Selar and Amazon KDP, drawing on all our divisions.
            </p>
          </div>
        </div>
        <div class="card flex gap-4 p-6">
          <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[12px] bg-teal-light text-teal">
            <Icon name="microscope" />
          </span>
          <div>
            <h3 class="text-lg">Research & Innovation</h3>
            <p class="mt-1 text-ink-muted">
              We explore new ideas across health, technology and education, and turn the best into products and
              services.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CertStrip />

  {
    site.team.length > 0 && (
      <section class="section" aria-labelledby="team-heading">
        <div class="container-site">
          <SectionHeading id="team-heading" eyebrow="Leadership" title="The people behind Eagle Innovia" />
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {site.team.map((m) => (
              <article class="card p-6">
                <h3 class="text-xl">{m.name}</h3>
                <p class="font-bold text-teal">{m.role}</p>
                {m.bio && <p class="mt-3 text-ink-muted">{m.bio}</p>}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="reg-heading">
    <div class="container-site max-w-3xl">
      <h2 id="reg-heading" class="text-2xl">Registration details</h2>
      <dl class="card mt-6 divide-y divide-line">
        <div class="grid gap-1 p-5 sm:grid-cols-3">
          <dt class="font-bold">Company name</dt>
          <dd class="sm:col-span-2">{site.name}</dd>
        </div>
        <div class="grid gap-1 p-5 sm:grid-cols-3">
          <dt class="font-bold">Registered in</dt>
          <dd class="sm:col-span-2">Nigeria</dd>
        </div>
        {
          isSet(site.cacNumber) && (
            <div class="grid gap-1 p-5 sm:grid-cols-3">
              <dt class="font-bold">CAC registration number</dt>
              <dd class="sm:col-span-2">{site.cacNumber}</dd>
            </div>
          )
        }
        <div class="grid gap-1 p-5 sm:grid-cols-3">
          <dt class="font-bold">Location</dt>
          <dd class="sm:col-span-2">{site.location.display}</dd>
        </div>
      </dl>
    </div>
  </section>

  <CTABand />
</BaseLayout>
