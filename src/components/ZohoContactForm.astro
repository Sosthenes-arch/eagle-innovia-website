---
/**
 * Zoho CRM Web-to-Lead form, restyled to the Eagle Innovia brand.
 * Based on the Zoho export that includes the Email field and the /thank-you return URL.
 *
 * DO NOT CHANGE (the form breaks otherwise):
 *  - <form> id, name, action, method, accept-charset and the onSubmit hook
 *  - every hidden input name/value (xnQsjsdp, zc_gad, xmIwtLD, actionType, returnURL, aG9uZXlwb3Q)
 *  - field `name` attributes ('First Name', 'Last Name', 'Email', 'Phone', 'Company', 'Description')
 *  - the function names checkMandatory7678017000000632312 and validateEmail7678017000000632312
 *    (incl. the smart-URL block and the line that disables the submit button)
 *
 * WHEN YOU RE-EXPORT THE FORM FROM ZOHO:
 *  1. Copy the new hidden input values (xnQsjsdp, xmIwtLD, returnURL …) and the form id/name if they changed.
 *  2. Add each new field with <FormField>, keeping Zoho's `name` exactly. For a picklist use
 *     `options={['-None-', 'Cloud & AWS', …]}`.
 *  3. Add any new mandatory field to mndFileds / fldLangVal in the script below.
 *  4. If the form id changes, update the number in the function names, onSubmit and document.forms[…].
 */
import FormField from './FormField.astro';
import { url } from '@/lib/url';
---

<div id="crmWebToEntityForm" class="crmWebToEntityForm card p-6 sm:p-8">
  <h2 class="text-2xl">Send us a message</h2>
  <p class="mt-2 text-ink-muted">
    Tell us a little about what you need. Fields marked <span class="font-bold text-teal">*</span> are
    required.
  </p>

  <form
    id="webform7678017000000632312"
    action="https://crm.zoho.com/crm/WebToLeadForm"
    name="WebToLeads7678017000000632312"
    method="POST"
    onSubmit='javascript:document.charset="UTF-8"; return checkMandatory7678017000000632312()'
    accept-charset="UTF-8"
    class="mt-6"
    novalidate
  >
    <!-- Zoho-generated hidden fields. Do not remove or rename. -->
    <input
      type="text"
      hidden
      name="xnQsjsdp"
      value="6ac6ecb77085b93c0ee6df1825eb78f9e6d80c504a57627dd0d4f3c31ab90861"
    />
    <input type="hidden" name="zc_gad" id="zc_gad" value="" />
    <input
      type="text"
      hidden
      name="xmIwtLD"
      value="e7e972c411c50e93ddac3a6492f343626f0d6791ce087ec63f6b5c99d6589967d47489135baab240f41426268a601565"
    />
    <input type="text" hidden name="actionType" value="TGVhZHM=" />
    <input type="text" hidden name="returnURL" value="https://www.eagleinnovia.com/thank-you" />

    <div class="grid gap-5 sm:grid-cols-2">
      <FormField id="First_Name" name="First Name" label="First name" maxlength={40} autocomplete="given-name" required />
      <FormField id="Last_Name" name="Last Name" label="Last name" maxlength={80} autocomplete="family-name" required />
      <FormField
        id="Email"
        name="Email"
        label="Email"
        type="email"
        ftype="email"
        maxlength={100}
        autocomplete="email"
        required
      />
      <FormField id="Phone" name="Phone" label="Phone" type="tel" maxlength={30} autocomplete="tel" />
      <FormField id="Company" name="Company" label="Company" maxlength={200} autocomplete="organization" full />
      <!-- New Zoho fields (e.g. Service of interest) go here, keeping Zoho's name attribute. -->
      <FormField
        id="Description"
        name="Description"
        label="How can we help?"
        textarea
        rows={5}
        full
        placeholder="For example: we want to move our app to AWS and cut our monthly bill, or we need a medical virtual assistant for our UK practice."
      />
    </div>

    <!-- Zoho honeypot. Do not remove. -->
    <input type="text" hidden name="aG9uZXlwb3Q" value="" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="mt-6">
      <input
        type="submit"
        id="formsubmit"
        class="formsubmit btn-primary w-full cursor-pointer disabled:cursor-wait disabled:opacity-80 sm:w-auto"
        value="Send message"
        title="Send message"
      />
      <p class="mt-4 text-sm text-ink-muted">
        We use your details only to reply to your enquiry. Read our <a href={url('/privacy')}>privacy notice</a>.
      </p>
    </div>

    <script is:inline>
      function zcwfSetError7678017000000632312(fieldObj, msg) {
        var err = document.getElementById(fieldObj.id + '-error');
        if (msg) {
          fieldObj.setAttribute('aria-invalid', 'true');
          if (err) {
            err.textContent = msg;
            err.hidden = false;
          }
        } else {
          fieldObj.removeAttribute('aria-invalid');
          if (err) {
            err.textContent = '';
            err.hidden = true;
          }
        }
      }

      // Zoho's email check, with inline errors instead of alert(). Returns the first invalid field or null.
      function validateEmail7678017000000632312() {
        var form = document.forms['WebToLeads7678017000000632312'];
        var emailFld = form.querySelectorAll('[ftype=email]');
        var firstBad = null;
        var i;
        for (i = 0; i < emailFld.length; i++) {
          var emailVal = emailFld[i].value;
          if (emailVal.replace(/^\s+|\s+$/g, '').length != 0) {
            var atpos = emailVal.indexOf('@');
            var dotpos = emailVal.lastIndexOf('.');
            if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= emailVal.length) {
              zcwfSetError7678017000000632312(emailFld[i], 'Please enter a valid email address.');
              if (!firstBad) {
                firstBad = emailFld[i];
              }
            }
          }
        }
        return firstBad;
      }

      function checkMandatory7678017000000632312(isAjax) {
        var mndFileds = new Array('First Name', 'Last Name', 'Email');
        var fldLangVal = new Array('First name', 'Last name', 'Email address');
        var form = document.forms['WebToLeads7678017000000632312'];
        var firstInvalid = null;
        for (i = 0; i < mndFileds.length; i++) {
          var fieldObj = form[mndFileds[i]];
          if (fieldObj) {
            var msg = '';
            if (fieldObj.value.replace(/^\s+|\s+$/g, '').length == 0) {
              if (fieldObj.type == 'file') {
                msg = 'Please select a file to upload.';
              } else {
                msg = 'Please enter your ' + fldLangVal[i].toLowerCase() + '.';
              }
            } else if (fieldObj.nodeName == 'SELECT') {
              if (fieldObj.options[fieldObj.selectedIndex].value == '-None-') {
                msg = 'Please choose ' + fldLangVal[i].toLowerCase() + '.';
              }
            } else if (fieldObj.type == 'checkbox') {
              if (fieldObj.checked == false) {
                msg = 'Please accept ' + fldLangVal[i] + '.';
              }
            }
            zcwfSetError7678017000000632312(fieldObj, msg);
            if (msg && !firstInvalid) {
              firstInvalid = fieldObj;
            }
            try {
              if (fieldObj.name == 'Last Name') {
                name = fieldObj.value;
              }
            } catch (e) {}
          }
        }
        var badEmail = validateEmail7678017000000632312();
        if (!firstInvalid && badEmail) {
          firstInvalid = badEmail;
        }
        if (firstInvalid) {
          firstInvalid.focus();
          return false;
        }
        var urlparams = new URLSearchParams(window.location.search);
        if (urlparams.has('service') && urlparams.get('service') === 'smarturl') {
          var webform = document.getElementById('webform7678017000000632312');
          var service = urlparams.get('service');
          var smarturlfield = document.createElement('input');
          smarturlfield.setAttribute('type', 'hidden');
          smarturlfield.setAttribute('value', service);
          smarturlfield.setAttribute('name', 'service');
          webform.appendChild(smarturlfield);
        }
        var submitBtn = document.querySelector('.crmWebToEntityForm .formsubmit');
        submitBtn.value = 'Sending…';
        submitBtn.setAttribute('aria-busy', 'true');
        document.querySelector('.crmWebToEntityForm .formsubmit').setAttribute('disabled', true);
      }

      // Clear a field's error as soon as the visitor fixes it.
      (function () {
        var form = document.forms['WebToLeads7678017000000632312'];
        if (!form) return;
        form.addEventListener('input', function (e) {
          var el = e.target;
          if (el.getAttribute && el.getAttribute('aria-invalid') === 'true' && el.value.trim().length > 0) {
            zcwfSetError7678017000000632312(el, '');
          }
        });
        // Re-enable the button if the visitor comes back with the browser's Back button.
        window.addEventListener('pageshow', function () {
          var btn = document.querySelector('.crmWebToEntityForm .formsubmit');
          if (btn) {
            btn.removeAttribute('disabled');
            btn.removeAttribute('aria-busy');
            btn.value = 'Send message';
          }
        });
      })();
    </script>
  </form>
</div>
