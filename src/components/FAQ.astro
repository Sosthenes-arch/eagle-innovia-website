---
/** Accessible accordion built on <details>/<summary> — keyboard and screen-reader friendly with no JS. */
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'Frequently asked questions' } = Astro.props;
---

{
  items.length > 0 && (
    <div>
      <h2 class="mb-6 text-2xl sm:text-3xl">{title}</h2>
      <div class="divide-y divide-line rounded-[12px] border border-line bg-white">
        {items.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-bold hover:text-teal [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span
                class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal-light text-teal transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="px-5 pb-5 text-ink-muted">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  )
}
