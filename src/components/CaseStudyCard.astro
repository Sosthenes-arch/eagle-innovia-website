---
import { Image } from 'astro:assets';
import { url } from '@/lib/url';
import { caseStudyImage } from '@/lib/caseStudyImage';
import Icon from './Icon.astro';

interface Props {
  slug: string;
  client: string;
  sector: string;
  summary: string;
  siteUrl: string;
  features?: string[];
  heading?: 'h2' | 'h3';
}
const { slug, client, sector, summary, siteUrl, features = [], heading = 'h3' } = Astro.props;
const H = heading;
const shot = await caseStudyImage(slug);
---

<article class="card overflow-hidden lg:grid lg:grid-cols-5">
  <div class="on-dark hero-dark flex flex-col justify-center gap-5 p-6 text-white sm:p-8 lg:col-span-2">
    <div>
      <p class="text-sm font-bold tracking-[0.16em] text-lime uppercase">Case study</p>
      <p class="mt-2 font-heading text-3xl font-bold text-white">{client}</p>
      <p class="mt-1 text-white/80">{sector}</p>
    </div>
    {
      shot && (
        <Image
          src={shot}
          alt={`${client} home page`}
          width={560}
          densities={[1, 2]}
          class="w-full rounded-[8px] border border-white/15 shadow-[var(--shadow-lift)]"
        />
      )
    }
  </div>
  <div class="p-8 lg:col-span-3">
    <H class="text-2xl">Built by Eagle Innovia: {client}</H>
    <p class="mt-3 text-ink-muted">{summary}</p>
    {
      features.length > 0 && (
        <ul class="mt-5 space-y-2">
          {features.slice(0, 4).map((f) => (
            <li class="flex gap-2">
              <Icon name="check" size={20} class="mt-1 shrink-0 text-teal" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
      )
    }
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href={url(`/case-studies/${slug}`)} class="btn-primary">
        Read the case study <Icon name="arrow-right" size={18} />
      </a>
      <a href={siteUrl} target="_blank" rel="noopener" class="btn-outline">
        Visit {client} <Icon name="external" size={18} /><span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</article>
