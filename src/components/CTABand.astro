---
import { url } from '@/lib/url';
import CalendlyButton from './CalendlyButton.astro';

interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  showCalendly?: boolean;
}
const {
  title = 'Ready to talk about your project?',
  text = 'Book a free 30-minute call. We will listen, ask the right questions and tell you honestly how we can help.',
  primaryLabel = 'Send us a message',
  primaryHref = '/contact',
  showCalendly = true,
} = Astro.props;
---

<section class="on-dark hero-dark text-white">
  <div class="container-site flex flex-col gap-8 py-16 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-2xl text-white sm:text-3xl">{title}</h2>
      <p class="mt-3 text-lg text-white/85">{text}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      {showCalendly && <CalendlyButton class="btn-accent" icon>Book a free call</CalendlyButton>}
      <a href={url(primaryHref)} class="btn-outline-light">{primaryLabel}</a>
    </div>
  </div>
</section>
